{
  "family": "hotstar-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::153402911367:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "hotstar-clone",
      "image": "<IMAGE>",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3000,
          "hostPort": 3000,
          "protocol": "tcp"
        }
      ]
    }
  ]
}
